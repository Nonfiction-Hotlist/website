const C = { forest: "#2e4a3b", deep: "#22382c", soft: "#c6d0bb", cream: "#ebe6d7", ink: "#1d2b23",
            locked: "#eef1e8", edit: "#ffffff", marker: "#5f6b5a" };
const FIRST_ROW = 5;            // body starts under banner (1), instructions (2), spacer (3), header (4)
const BUDGET_MS = 4.5 * 60 * 1000;
const TABS = {
  Pages: { cols: ["Title", "Address", "Description", "Doc"], widths: [220, 220, 460, 300], rows: 60,
    note: "One row per page. Address is the web address, like /contributors/ (start and end with /). Description is the line search engines show. The Doc column is filled in for you." },
  News: { cols: ["Title", "Date", "Address", "Listing image", "Excerpt", "Doc"], widths: [220, 110, 220, 220, 460, 300], rows: 100,
    note: "One row per post, any order (the site lists newest first). Date as 2026-05-28. Address like /news/indiewire/. Listing image is a file name from the Media folder. The Doc column is filled in for you." },
  Menu: { cols: ["Label", "Link", "Under"], widths: [220, 360, 220], rows: 30,
    note: "The menu at the top of every page, in order. Leave Link empty for a heading that opens a list; put that heading's label in Under for the items below it." },
  Footer: { cols: ["Column", "Label", "Link"], widths: [220, 260, 360], rows: 30,
    note: "Links at the bottom of every page, grouped by Column, in order." },
  Settings: { cols: ["Setting", "Value"], widths: [260, 460], rows: 10,
    note: "Site-wide settings." }
};

/* ============================== entry points ============================== */

function buildKit() {
  const started = Date.now();
  const state = loadState_();
  const root = root_(state);
  const out = (msg) => Logger.log(msg);
  const pagesF = folder_(root, "01 Pages"), newsF = folder_(root, "02 News"), media = folder_(root, "Media");

  if (!state.guide) { state.guide = makeGuide_(root); saveState_(state); out("Guide written"); }
  if (!state.site) { state.site = makeSiteSheet_(root); saveState_(state); out("Site sheet"); }

  for (const p of KIT.pages) {
    if (state.docs[p.file]) continue;
    if (Date.now() - started > BUDGET_MS) return pause_(state);
    state.docs[p.file] = makeDoc_(pagesF, p.title, p.doc); saveState_(state); out("Page: " + p.title);
  }
  for (const n of KIT.news) {
    if (state.news[n.file]) continue;
    if (Date.now() - started > BUDGET_MS) return pause_(state);
    state.news[n.file] = makeDoc_(newsF, n.title, n.doc); saveState_(state); out("News: " + n.title);
  }
  if (!state.rowsFilled) { fillRows_(state); state.rowsFilled = true; saveState_(state); out("Pages and News tabs filled in"); }

  for (const m of KIT.media) {
    if (state.media[m.name]) continue;
    if (Date.now() - started > BUDGET_MS) return pause_(state);
    if (!media.getFilesByName(m.name).hasNext()) media.createFile(UrlFetchApp.fetch(m.url).getBlob().setName(m.name));
    state.media[m.name] = true; saveState_(state); out("Image: " + m.name);
  }

  state.manifest = writeManifest_(root, state);
  saveState_(state);

  // The team edits through the editors group; the website reads by link. The link only gives viewing.
  if (KIT.editors) { try { root.addEditor(KIT.editors); } catch (e) { out(`Could not add ${KIT.editors} as editors: ${e}`); } }
  try { root.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW); } catch (e) { out("Folder link sharing not allowed here; sharing the files instead."); }
  const unshared = shareFiles_(state);
  if (unshared) out(`Link sharing was refused for ${unshared} file(s). The Workspace must allow "anyone with the link" sharing before the website can read this kit. Once it does, run buildKit again.`);

  clearTriggers_();
  if (!ScriptApp.getProjectTriggers().some(t => t.getHandlerFunction() === "refreshKit"))
    ScriptApp.newTrigger("refreshKit").timeBased().everyMinutes(10).create();
  out("Done. Site manifest ID: " + state.manifest);
  out("Send this ID to Claude to connect the kit to the website.");
}

/**
 * Every 10 minutes (set up by buildKit): makes a Doc for any new row in the Pages or News tab, and
 * lists the Media folder's images in the manifest so the website picks up new or replaced ones.
 */
function refreshKit() {
  const state = loadState_();
  if (!state.manifest) return;
  const root = root_(state);
  const ss = SpreadsheetApp.openById(state.site.fileId);
  let made = 0;
  for (const [tab, folderName] of [["Pages", "01 Pages"], ["News", "02 News"]]) {
    const sh = ss.getSheetByName(tab);
    const spec = TABS[tab], docCol = spec.cols.indexOf("Doc") + 1;
    const rows = sh.getRange(FIRST_ROW, 1, spec.rows, spec.cols.length).getValues();
    rows.forEach((r, i) => {
      const title = String(r[0] || "").trim();
      if (!title || String(r[docCol - 1] || "").trim()) return;
      const id = makeDoc_(folder_(root, folderName), title, [{ style: "MARKER", runs: [{ t: "[section]" }] }, { style: "P", runs: [{ t: "Write the page here." }] }]);
      sh.getRange(FIRST_ROW + i, docCol).setValue(docUrl_(id));
      share_(id);
      made++;
    });
  }
  state.manifest = writeManifest_(root, state);
  saveState_(state);
  if (made) Logger.log(`${made} new Doc(s) made.`);
}

/** Keeps going after a pause. Called by the time trigger buildKit sets up. */
function continueKit() { buildKit(); }

/** Forgets progress so the next run builds everything again (files already made are not deleted). */
function resetKit() { PropertiesService.getScriptProperties().deleteProperty("kit"); clearTriggers_(); }

/* ============================== state ============================== */

function loadState_() {
  const raw = PropertiesService.getScriptProperties().getProperty("kit");
  return raw ? JSON.parse(raw) : { docs: {}, news: {}, media: {} };
}
function saveState_(s) { PropertiesService.getScriptProperties().setProperty("kit", JSON.stringify(s)); }
function pause_(state) {
  saveState_(state);
  clearTriggers_();
  ScriptApp.newTrigger("continueKit").timeBased().after(60 * 1000).create();
  Logger.log("Paused to stay under Google's time limit. It will continue on its own in about a minute.");
}
function clearTriggers_() {
  ScriptApp.getProjectTriggers().filter(t => t.getHandlerFunction() === "continueKit").forEach(t => ScriptApp.deleteTrigger(t));
}
// The kit folder: a folder named KIT.folderName inside KIT.parentFolderId, made on the first run.
function root_(state) {
  if (state.root) return DriveApp.getFolderById(state.root);
  const f = folder_(DriveApp.getFolderById(KIT.parentFolderId), KIT.folderName);
  state.root = f.getId(); saveState_(state);
  return f;
}
function folder_(parent, name) {
  const it = parent.getFoldersByName(name);
  return it.hasNext() ? it.next() : parent.createFolder(name);
}
function moveTo_(id, folder) { DriveApp.getFileById(id).moveTo(folder); return id; }
const docUrl_ = id => `https://docs.google.com/document/d/${id}/edit`;
const idFromUrl_ = url => (String(url).match(/\/d\/([\w-]{20,})/) || [])[1] || "";
function share_(id) {
  try { DriveApp.getFileById(id).setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW); return true; }
  catch (e) { return false; }
}
// Every kit file the website reads. Returns how many the Workspace refused to share by link.
function shareFiles_(state) {
  const ids = [state.guide, state.site && state.site.fileId, state.manifest]
    .concat(Object.values(state.docs), Object.values(state.news)).filter(Boolean);
  return ids.filter(id => !share_(id)).length;
}

/* ============================== docs ============================== */

// Writes paragraphs ({ style, runs: [{ t, b, i, href }] }) into a new Doc. Bracket lines (MARKER)
// are grey and monospaced so they stand out as building blocks rather than text.
function makeDoc_(folder, title, paras) {
  const doc = DocumentApp.create(title);
  moveTo_(doc.getId(), folder);
  const body = doc.getBody();
  body.clear();
  const H = { H1: DocumentApp.ParagraphHeading.HEADING1, H2: DocumentApp.ParagraphHeading.HEADING2,
    H3: DocumentApp.ParagraphHeading.HEADING3, H4: DocumentApp.ParagraphHeading.HEADING4 };
  paras.forEach(p => {
    const text = p.runs.map(r => r.t).join("");
    const el = p.style === "BULLET" ? body.appendListItem(text).setGlyphType(DocumentApp.GlyphType.BULLET) : body.appendParagraph(text);
    el.setHeading(H[p.style] || DocumentApp.ParagraphHeading.NORMAL);
    if (!text) return;
    const t = el.editAsText();
    t.setBold(false).setItalic(false).setLinkUrl(null);
    let pos = 0;
    p.runs.forEach(r => {
      const end = pos + r.t.length - 1;
      if (r.b) t.setBold(pos, end, true);
      if (r.i) t.setItalic(pos, end, true);
      if (r.href) t.setLinkUrl(pos, end, r.href);
      pos += r.t.length;
    });
    if (p.style === "MARKER") t.setForegroundColor(C.marker).setFontFamily("Roboto Mono");
  });
  // body.clear() leaves one empty paragraph at the top.
  if (body.getNumChildren() > 1 && !body.getChild(0).asText().getText()) body.getChild(0).removeFromParent();
  doc.saveAndClose();
  return doc.getId();
}

function makeGuide_(root) {
  const doc = DocumentApp.create("00 How this works");
  moveTo_(doc.getId(), root);
  const b = doc.getBody();
  b.clear();
  b.getParagraphs()[0].setText("The Nonfiction Hotlist website · How this works");
  b.getParagraphs()[0].setHeading(DocumentApp.ParagraphHeading.HEADING1);
  const H = t => b.appendParagraph(t).setHeading(DocumentApp.ParagraphHeading.HEADING2);
  const P = t => b.appendParagraph(t);
  const L = t => b.appendListItem(t).setGlyphType(DocumentApp.GlyphType.BULLET);
  P(`This folder is the source for ${KIT.siteUrl}. Edit the Docs and the Site sheet, and the website updates on its own, usually within 15 minutes.`);
  H("What's where");
  L("01 Pages: one Google Doc per page. Headings, bold, italics, bullet lists and links all carry over to the website.");
  L("02 News: one Google Doc per news post.");
  L("Media: the images pages use.");
  L("Site: a Google Sheet. Pages and News list every page and post with its title, web address and description. Menu, Footer and Settings are the parts shared by every page.");
  L("Site manifest: the map the website reads. Don't edit, move or rename it.");
  H("Building blocks");
  P("Some lines in the page Docs are in grey brackets. They stand for things a Doc can't show. Keep each on its own line, and keep the brackets.");
  L("[section name]: starts a new band of the page. The name is optional.");
  L("[button: Label | /link/]: a button. The link can be a page address like /submit2026/ or a full link.");
  L("[image: file name.jpg]: an image from the Media folder, by its file name.");
  L("[background video: file name.mp4]: a video from the Media folder playing silently behind its section, like the home page. Put it right under the section's [section] line.");
  L("[faq] then [end faq]: questions and answers. Each question is a Heading 3; its answer is the text under it.");
  L("[marquee: Shorts · Podcasts · Features]: a line of words that scrolls by.");
  L("[form: contact], [embed: https://...], [news list]: a form, another website shown in the page, the list of news posts.");
  H("Adding a page or a post");
  L("Add a row to the Pages or News tab in the Site sheet. Within about 10 minutes its Doc appears in 01 Pages or 02 News, linked in the row's Doc column. Write in that Doc.");
  L("A new page shows up in the menu only once it's added to the Menu tab.");
  H("If something doesn't show up");
  L("A change that breaks a rule (a [button] without a link, an [image] that isn't in Media, a [faq] without [end faq]) is skipped, and the page keeps its previous text. The site owner gets an email listing what was skipped.");
  L(`To publish right away, the site owner can run the Publish workflow: ${KIT.repoUrl}/actions`);
  L("Every Doc and Sheet keeps version history (File > Version history) if you need to roll back.");
  H("Videos");
  L("Background videos (silent, looping, up to 60 seconds): drop the exported file in Media at full quality. The website makes its own lighter versions within about 15 minutes. To replace one, upload the new file with the same name.");
  L("Videos with sound, and anything longer (trailers, films, talks): put them on Vimeo or YouTube and place them with [embed: link]. They stream better there, and the website stays fast.");
  H("House style");
  L("Understated and direct. No em dashes.");
  doc.saveAndClose();
  return doc.getId();
}

/* ============================== site sheet ============================== */

function makeSiteSheet_(root) {
  const ss = SpreadsheetApp.create("Site");
  moveTo_(ss.getId(), root);
  const tabs = {};
  let first = true;
  for (const [name, spec] of Object.entries(TABS)) {
    const sh = first ? ss.getSheets()[0].setName(name) : ss.insertSheet(name);
    first = false;
    frame_(sh, name, spec.note, spec.cols, spec.rows, spec.widths);
    sh.getRange(FIRST_ROW, 1, spec.rows, spec.cols.length).setNumberFormat("@").setBackground(C.edit).setWrap(true);
    tabs[name] = sh.getSheetId();
  }
  const rows = (name, values) => { if (values.length) ss.getSheetByName(name).getRange(FIRST_ROW, 1, values.length, TABS[name].cols.length).setValues(values); };
  rows("Menu", KIT.site.menu);
  rows("Footer", KIT.site.footer);
  rows("Settings", KIT.site.settings);
  // The Doc columns are filled in by the kit, so they're shaded; editing them only warns.
  for (const name of ["Pages", "News"]) {
    const sh = ss.getSheetByName(name), spec = TABS[name], col = spec.cols.indexOf("Doc") + 1;
    sh.getRange(FIRST_ROW, col, spec.rows, 1).setBackground(C.locked);
    sh.getRange(FIRST_ROW, col, spec.rows, 1).protect().setDescription("Filled in by the kit").setWarningOnly(true);
  }
  SpreadsheetApp.flush();
  return { fileId: ss.getId(), tabs };
}

// Pages and News rows, with links to the Docs made for them.
function fillRows_(state) {
  const ss = SpreadsheetApp.openById(state.site.fileId);
  const pages = KIT.pages.map(p => [p.title, p.path, p.description, docUrl_(state.docs[p.file])]);
  const news = KIT.news.map(n => [n.title, n.date, n.path, n.image, n.excerpt, docUrl_(state.news[n.file])]);
  if (pages.length) ss.getSheetByName("Pages").getRange(FIRST_ROW, 1, pages.length, TABS.Pages.cols.length).setValues(pages);
  if (news.length) ss.getSheetByName("News").getRange(FIRST_ROW, 1, news.length, TABS.News.cols.length).setValues(news);
}

// Banner, instructions, header row; body rows below. Columns past the table are removed.
function frame_(sh, title, note, header, bodyRows, widths) {
  const n = header.length;
  sh.clear();
  const total = FIRST_ROW - 1 + bodyRows;
  if (sh.getMaxRows() > total) sh.deleteRows(total + 1, sh.getMaxRows() - total);
  if (sh.getMaxRows() < total) sh.insertRowsAfter(sh.getMaxRows(), total - sh.getMaxRows());
  if (sh.getMaxColumns() > n) sh.deleteColumns(n + 1, sh.getMaxColumns() - n);
  const banner = n > 1 ? sh.getRange(1, 1, 1, n).merge() : sh.getRange(1, 1);
  banner.setValue(title).setFontSize(15).setFontWeight("bold").setFontColor(C.cream).setBackground(C.forest).setVerticalAlignment("middle");
  sh.setRowHeight(1, 40);
  (n > 1 ? sh.getRange(2, 1, 1, n).merge() : sh.getRange(2, 1)).setValue(note).setWrap(true).setFontColor(C.ink).setBackground(C.soft).setVerticalAlignment("middle");
  sh.setRowHeight(2, 48);
  sh.getRange(3, 1, 1, n).setBackground(C.locked);
  sh.setRowHeight(3, 8);
  sh.getRange(4, 1, 1, n).setValues([header]).setFontWeight("bold").setFontColor(C.cream).setBackground(C.deep);
  widths.forEach((w, i) => sh.setColumnWidth(i + 1, w));
  sh.setFrozenRows(4);
  sh.getRange(1, 1, total, n).setFontFamily("Arial").setVerticalAlignment("top");
}

/* ============================== manifest ============================== */

function writeManifest_(root, state) {
  let ss;
  if (state.manifest) ss = SpreadsheetApp.openById(state.manifest);
  else { ss = SpreadsheetApp.create("Site manifest (do not edit)"); moveTo_(ss.getId(), root); }
  const sh = ss.getSheets()[0].setName("Files");
  const rows = [["Kind", "Key", "Label", "File ID", "Tabs", "Folder ID", "Updated"]];
  rows.push(["site", "site", "Site", state.site.fileId, JSON.stringify(state.site.tabs), root.getId(), ""]);
  // Every image and video in Media, with when it last changed, so the website fetches new and replaced ones.
  const files = folder_(root, "Media").getFiles();
  const media = [];
  while (files.hasNext()) {
    const f = files.next();
    const mime = f.getMimeType();
    if (/^(image|video)\//.test(mime)) media.push(["media", f.getName(), f.getName(), f.getId(), JSON.stringify({ mime }), "", f.getLastUpdated().toISOString()]);
  }
  media.sort((a, b) => a[1] < b[1] ? -1 : 1).forEach(r => rows.push(r));
  // Every page and news Doc (from the Doc column of the Pages and News tabs), so the publish trigger
  // notices when one is edited. The website itself reads them through the Site sheet.
  if (state.rowsFilled) {
    const site = SpreadsheetApp.openById(state.site.fileId);
    for (const tab of ["Pages", "News"]) {
      const spec = TABS[tab], docCol = spec.cols.indexOf("Doc");
      site.getSheetByName(tab).getRange(FIRST_ROW, 1, spec.rows, spec.cols.length).getValues().forEach(r => {
        const id = idFromUrl_(r[docCol]);
        if (id) rows.push(["doc", tab.toLowerCase(), String(r[0]), id, "{}", "", ""]);
      });
    }
  }
  rows.push(["folder", "root", "Kit folder", "", "{}", root.getId(), ""]);
  rows.push(["folder", "pages", "Pages folder", "", "{}", folder_(root, "01 Pages").getId(), ""]);
  rows.push(["folder", "news", "News folder", "", "{}", folder_(root, "02 News").getId(), ""]);
  rows.push(["folder", "media", "Media folder", "", "{}", folder_(root, "Media").getId(), ""]);
  if (state.guide) rows.push(["guide", "guide", "How this works", state.guide, "{}", "", ""]);
  sh.clear();
  if (sh.getMaxRows() < rows.length) sh.insertRowsAfter(sh.getMaxRows(), rows.length - sh.getMaxRows());
  sh.getRange(1, 1, rows.length, 7).setValues(rows);
  sh.getRange(1, 1, 1, 7).setFontWeight("bold");
  return ss.getId();
}
